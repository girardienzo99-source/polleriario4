# Entorno de la aplicación
NEXT_PUBLIC_APP_NAME="POLLERÍA PRO — Sistema de Gestión Gastronómica"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Conexión Supabase PostgreSQL (Opcional en modo Demo, Obligatorio para Producción)
# Obtené tus credenciales en https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Facturación Electrónica ARCA (ex AFIP)
# Valores soportados para ARCA_ENVIRONMENT: 'homologacion' o 'produccion'
ARCA_ENVIRONMENT="homologacion"
ARCA_CUIT="30715894129"
ARCA_PTO_VTA="1"

# Certificados Digitales ARCA (Rutas o certificados en Base64 para el backend)
ARCA_CERT_PATH="./certs/homo.crt"
ARCA_KEY_PATH="./certs/homo.key"
